# Copy to .env (local) or set these in your hosting dashboard.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://goldenopinions.com
# Optional: serve the admin console only on this host (point a DNS record at the same server)
ADMIN_HOST=admin.goldenopinions.com
# Long random string (e.g. `openssl rand -hex 32`). Required in production.
APP_SECRET=
# Where the SQLite database lives — must be a persistent disk/volume
DATA_DIR=/data
BUSINESS_TZ=America/Phoenix
TRUST_PROXY=true

COMPANY_NAME=Golden Opinions LLC
COMPANY_ADDRESS=123 Main St, Phoenix, AZ 85001
SUPPORT_EMAIL=support@goldenopinions.com

# Twilio (texts). Use a Messaging Service registered for A2P 10DLC.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# or a single sending number instead of a Messaging Service:
TWILIO_FROM=

# Postmark (email). Verify your domain in Postmark first.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=Golden Opinions <hello@goldenopinions.com>
POSTMARK_STREAM=outbound
# Optional: a separate "broadcast" stream for campaign emails
POSTMARK_BROADCAST_STREAM=

# Local testing only: show log-in codes on screen when no SMS/email provider is set. Ignored in production.
DEV_SHOW_CODES=

# "Run a survey with us" requests from the app are emailed here (and listed in the admin console under Inquiries)
INQUIRY_EMAIL=connect@mygoldenopinions.com
